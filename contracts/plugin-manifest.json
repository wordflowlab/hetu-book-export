{
  "manifest_version": 1,
  "host_api": "1",
  "id": "org.wordflowlab.book-export",
  "version": "0.1.0",
  "display": {
    "zh-CN": "书稿交付",
    "en": "Book Export"
  },
  "description": {
    "zh-CN": "从固定卷章和正文编译可核验的书稿文件，保留版式、来源与转换说明。",
    "en": "Book Export with fixed sources and external Agent workflows."
  },
  "license": "Apache-2.0",
  "dependencies": [],
  "work_kinds": [
    "novel"
  ],
  "runtime": {
    "entry": "backend.mjs"
  },
  "contributions": {
    "views": [
      {
        "id": "main",
        "title": "书稿交付",
        "entry": "index.html",
        "object_kinds": [
          "book_export"
        ],
        "navigation": "integrated"
      }
    ],
    "data": [
      {
        "kind": "book_export",
        "schema_version": "1.0.0",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format_version": {
              "const": 1
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "chapters": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "source_index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63
                  },
                  "volume": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 200
                  },
                  "include": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "source_index",
                  "volume",
                  "include"
                ]
              },
              "maxItems": 300
            },
            "footnotes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "chapter_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "marker": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  }
                },
                "required": [
                  "id",
                  "chapter_id",
                  "marker",
                  "text"
                ]
              },
              "maxItems": 300
            },
            "illustrations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "chapter_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "caption": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 2000
                  },
                  "media_type": {
                    "type": "string",
                    "enum": [
                      "image/png",
                      "image/jpeg"
                    ]
                  },
                  "base64": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120000
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "id",
                  "chapter_id",
                  "caption",
                  "media_type",
                  "base64",
                  "sha256"
                ]
              },
              "maxItems": 300
            },
            "author": {
              "type": "string",
              "minLength": 0,
              "maxLength": 200
            },
            "language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "identifier": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "page_size": {
              "type": "string",
              "enum": [
                "A5",
                "A4"
              ]
            },
            "font_size": {
              "type": "integer",
              "minimum": 10,
              "maximum": 24
            },
            "basis_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "owner_plugin_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "object_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "owner_plugin_id",
                  "object_id",
                  "revision",
                  "sha256"
                ]
              },
              "maxItems": 20
            }
          },
          "required": [
            "format_version",
            "title",
            "chapters",
            "footnotes",
            "illustrations",
            "author",
            "language",
            "identifier",
            "page_size",
            "font_size",
            "basis_refs"
          ]
        }
      }
    ],
